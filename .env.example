VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_clave_publica_anon
VITE_NEGOCIO_USER_ID=uuid_del_usuario_propietario

# Requerida en producción. En desarrollo Vite usa el proxy local :3100.
VITE_AUTORESPONDER_URL=https://tu-dominio-del-microservicio

# Opcional: sobrescribe el proxy local cuando ejecutas el bot sin Docker Compose.
AUTORESPONDER_DEV_URL=http://localhost:3100

# Email del SuperAdmin (Configuración de seguridad)
VITE_SUPERADMIN_EMAIL=superadmin@ejemplo.com

