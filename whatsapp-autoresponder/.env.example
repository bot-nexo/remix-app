# ─────────────────────────────────────────────
# Puerto en el que escucha el servidor Express
# ─────────────────────────────────────────────
PORT=3000

# ─────────────────────────────────────────────
# Clave secreta para los endpoints de administración
# Cabecera requerida: x-api-key: <valor>
# ─────────────────────────────────────────────
ADMIN_API_KEY=tu_clave_secreta_admin

# ─────────────────────────────────────────────
# Configuración de Evolution API
# ─────────────────────────────────────────────
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_API_KEY=tu_apikey_evolution
EVOLUTION_INSTANCE_NAME=tu_instancia
EVOLUTION_WEBHOOK_URL=http://whatsapp-bot:3000/webhook/evolution
EVOLUTION_WEBHOOK_SECRET=secreto_aleatorio_de_64_caracteres

# Contraseña PostgreSQL usada por Docker Compose.
# Genera un valor hexadecimal aleatorio para evitar problemas de URL encoding.
POSTGRES_PASSWORD=hexadecimal_aleatorio_largo

# Acceso del panel a las operaciones de WhatsApp
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_anon_key
WHATSAPP_ADMIN_USER_ID=uuid_del_usuario_propietario
FRONTEND_ORIGINS=http://localhost:5757,https://angelnailsagenda.netlify.app
SUPABASE_SERVICE_ROLE_KEY=service_role_key_solo_servidor
BOOKING_LINK_SECRET=secreto_largo_aleatorio_solo_servidor
